# Bash configuration loaded by the launchers. Copy to .env.local, then edit.
# The defaults use the current Python environment and bundled local model path.
DEMO_PORT=7860
DEMO_HOST=127.0.0.1
DEMO_PRECISION=float16
DEMO_MAX_SECONDS=60
DEMO_PROXY_MODE=inherit
# Default: MMS-LID-256 on the same GPU as SeamlessM4T.
# Use speechbrain for the original CPU detector; defaults follow the backend.
DEMO_LID_BACKEND=mms
DEMO_LID_PRECISION=float32
DEMO_LID_MAX_SECONDS=10
DEMO_LID_MIN_CONFIDENCE=0.5
# DEMO_LID_MODEL_DIR=/path/to/mms-lid-256
# File translation defaults to SeamlessM4T end-to-end speech translation.
# Realtime uses Hy-MT2 + vLLM; optional file cascade reuses that text translator.
DEMO_REALTIME=1
DEMO_FILE_TRANSLATION=speech
# File cascade uses the shared Nemotron in full-file/offline mode.
# DEMO_FILE_ASR_TIMEOUT=120
DEMO_MT_BACKEND=hy-mt2-vllm
DEMO_MANAGE_VLLM=1
# Slurm launchers default OMP/MKL threads to the allocated CPUs (normally 8).
# Override with fewer threads if needed; do not exceed your allocation.
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8

# Optional environment setup on nodes where your interactive environment is absent.
# DEMO_MODULES="module-name another-module"
# DEMO_SETUP_SH=/path/to/site-setup.sh
# DEMO_CONDA_SH=/path/to/conda/etc/profile.d/conda.sh
# DEMO_CONDA_ENV=st_demo
# DEMO_PYTHON=/path/to/env/bin/python
# DEMO_FFMPEG_DIR=/path/to/ffmpeg/bin
# DEMO_MODEL_DIR=/path/to/seamless-m4t-v2-large

# Streaming ASR + text translation, shared by both production pages.
# REALTIME_ASR_MODEL_DIR=/path/to/nemotron-3.5-asr-streaming-0.6b
# REALTIME_ASR_PRECISION=float32      # keep RNNT FP32 initially
# REALTIME_ASR_LOOKAHEAD=3            # 0/3/6/13; 80/320/560/1120 ms ASR context
# REALTIME_TRANSLATION_INTERVAL=0.6   # refresh scheduling, never cuts the audio
# REALTIME_MAX_SECONDS=120
# REALTIME_T2T_MAX_SOURCE_TOKENS=1024
# REALTIME_T2T_MAX_NEW_TOKENS=1024
# REALTIME_MT_STREAMING=1           # Hy-MT2: live generation drafts; 0: full results only
# REALTIME_CUDA_STREAMS=1           # ASR high-priority queue + separate MT queue; 0: compatibility mode
# REALTIME_HY_MT_MODEL_DIR=ckpts/Hy-MT2-1.8B  # also accepts ckpts/Hy-MT2-7B
# REALTIME_HY_MT_PRECISION=bfloat16  # separate from DEMO_PRECISION
# REALTIME_HY_MT_MAX_SOURCE_TOKENS=4096  # prompt + chat template included
# REALTIME_HY_MT_MAX_NEW_TOKENS=1024
# REALTIME_HY_MT_SAMPLING=0          # 1: official .7/.6/20 sampling; 0: greedy
# Mic auto-stop is a browser setting: enabled, 2.5s trailing silence by default.
# It does not require a VAD model or server environment variable.

# Production automatically starts one vLLM engine in the same job/environment.
# DEMO_MANAGE_VLLM=0 connects an existing API; stop it separately.
# See docs/vllm.md for version caveats, CPU checks and production launchers.
# REALTIME_VLLM_PYTHON=/path/to/python  # optional override; unset uses DEMO_PYTHON
# REALTIME_VLLM_MODEL_DIR=ckpts/Hy-MT2-1.8B
# REALTIME_VLLM_API_BASE=http://127.0.0.1:8000/v1
# REALTIME_VLLM_PORT=8000            # standalone engine only; managed Demo reads API_BASE
# REALTIME_VLLM_SERVED_MODEL=hy-mt2
# REALTIME_VLLM_GPU_MEMORY_UTILIZATION=0.4  # fraction of TOTAL GPU memory; not actual weight size
# REALTIME_VLLM_MAX_MODEL_LEN=8192
# REALTIME_VLLM_MAX_NUM_SEQS=1
# REALTIME_VLLM_MAX_BATCHED_TOKENS=512
# REALTIME_VLLM_MODEL_IMPL=auto      # omit normally; transformers requires compatible engine/Transformers
# REALTIME_VLLM_ENFORCE_EAGER=0      # 1: diagnostic fallback, may reduce decode speed
# REALTIME_VLLM_TOKENIZER_COMPAT=1   # TF5 + vLLM 0.10.2 legacy attribute; scoped to engine workers
# REALTIME_VLLM_STARTUP_TIMEOUT=1800
# REALTIME_VLLM_REQUEST_TIMEOUT=180
# REALTIME_VLLM_API_KEY=             # optional; no key in command line or URLs

# Login-node relay: required only for scripts/slurm/serve_login_relay.sh.
DEMO_RELAY_TARGET=
DEMO_RELAY_PORT=17860
# Engine compilation + model startup can exceed the old 300-second wait.
# DEMO_RELAY_BACKEND_TIMEOUT=2400
DEMO_RELAY_PROXY_URL=
# Optional separate FRPC route; unset inherits DEMO_RELAY_PROXY_URL.
# Set empty only when the share server is directly reachable but the API needs a proxy.
# DEMO_RELAY_FRPC_PROXY_URL=
# DEMO_RELAY_SSH_KEY="$HOME/.ssh/speech_demo_relay"
# DEMO_RELAY_PROJECT_DIR=/path/on/login/node/Speech_Translation_Demo
# DEMO_RELAY_PYTHON=/path/on/login/node/env/bin/python

# Public SSH server: required only for the public-tunnel launchers.
DEMO_TUNNEL_TARGET=
DEMO_TUNNEL_PORT=17860

# Optional Gradio login. Set both variables together.
# DEMO_AUTH_USER=demo
# DEMO_AUTH_PASSWORD=
